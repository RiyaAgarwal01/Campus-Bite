# GEMINI_API_KEY: Required for Gemini AI meal recommendation assistant.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Optional Razorpay API credentials for live UPI/Card payments.
# When omitted, Cash on Delivery remains live and Razorpay displays setup instructions.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
